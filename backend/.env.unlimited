# UNLIMITED ACCESS CONFIGURATION
# Use this configuration if you have unlimited Pollinations API access

# Server Configuration
PORT=3000
NODE_ENV=production

# Pollinations API Configuration
POLLINATIONS_API_TOKEN=your_pollinations_token_here
POLLINATIONS_API_BASE_URL=https://text.pollinations.ai
POLLINATIONS_MODEL=searchgpt

# Rate Limiting - DISABLED for unlimited access
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=999999

# Cache Configuration (in seconds)
# Longer cache for unlimited mode to maximize performance
CACHE_TTL=7200
CACHE_CHECK_PERIOD=600

# CORS Configuration (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
