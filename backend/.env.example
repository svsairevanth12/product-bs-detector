# Pollinations AI API Token (Get from https://auth.pollinations.ai/)
POLLINATIONS_API_TOKEN=your_token_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Redis Configuration (Optional - for caching)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# CORS Configuration (Add your extension ID or domain)
CORS_ORIGINS=["chrome-extension://*", "http://localhost:*"]

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=20

# Model Configuration
POLLINATIONS_MODEL=searchgpt
# Available models: searchgpt, gemini, openai, mistral
